    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fontsource/source-serif-4": "^5.3.1",
    "fast-glob": "^3.3.3",
    "handlebars": "^4.7.8",
    "markdown-it": "^15.0.3",
    "markdown-it-deflist": "^4.0.0",
    "pagedjs": "^0.4.3",
    "sanitize-html": "^2.18.1"
  }
